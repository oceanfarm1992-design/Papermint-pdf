{
  // Markdown lint rules for docs and README (used by the CI docs job).
  "default": true,
  "MD013": false, // line length — prose is wrapped by the editor
  "MD033": false, // inline HTML is fine in GitHub markdown
  "MD041": false, // first line need not be a top-level heading
  "MD024": { "siblings_only": true }, // repeated headings allowed across sections
  "MD060": false // table pipe alignment — GitHub renders both styles fine
}
